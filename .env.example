# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/sk_sweets
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/sk_sweets?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sk_sweets

# Database name
DB_NAME=sk_sweets

# JWT Secret - MUST be a strong random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-random-secret-key-here

# Node Environment
NODE_ENV=development

# Optional: API Base URL
# NEXT_PUBLIC_API_URL=http://localhost:3000
